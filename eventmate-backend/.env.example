# EventMate Secret Configuration Example
# Copy this file to .env and fill in your actual secrets.
# NEVER commit the actual .env file or real credentials.

# Database
DB_URL=jdbc:mysql://localhost:3306/eventmate
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Cloudinary
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET=your_cloudinary_api_secret

# Gmail SMTP (For mail delivery)
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# AI & Payments
GEMINI_KEY=your_gemini_api_key
STRIPE_SECRET=sk_test_your_stripe_secret_key

# Security
# Generate a strong 256-bit key with: openssl rand -base64 32
JWT_SECRET=your_base64_encoded_jwt_secret_key_here
